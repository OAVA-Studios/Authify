{
  "name": "@authify/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "bun run --watch src/index.ts",
    "start": "bun run dist/index.js",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@authify/db": "workspace:*",
    "@authify/shared": "workspace:*",
    "@hono/zod-validator": "^0.2.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.8.0",
    "drizzle-orm": "^0.31.0",
    "helmet": "^7.1.0",
    "hono": "^4.5.0",
    "hono-openapi": "^1.3.0",
    "ioredis": "^5.4.0",
    "jose": "^5.6.0",
    "minio": "^8.0.0",
    "otplib": "^12.0.1",
    "pino": "^9.2.0",
    "sharp": "^0.33.0",
    "swagger-ui-dist": "^5.32.5",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "^1.1.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.0",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.0.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}